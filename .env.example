# ---- Public configuration (safe to expose to the browser) ----

# Launch gates: flip to "true" only after each item is confirmed.
NEXT_PUBLIC_PHONE_CONFIRMED=false
NEXT_PUBLIC_EMAIL_ACTIVE=false

# Credential display states: pending | active | expired | hidden
# LAUNCH GATE: set to "active" only after real verification.
NEXT_PUBLIC_NASM_CPT_STATUS=pending
NEXT_PUBLIC_CPR_AED_STATUS=pending
NEXT_PUBLIC_NASM_CNC_STATUS=pending

# Real admin-controlled founding-client count (0 hides all founding pricing).
NEXT_PUBLIC_FOUNDING_SPOTS_REMAINING=6

# External booking URL (Calendly, Cal.com, etc.). Empty = booking buttons
# fall back to the contact form.
NEXT_PUBLIC_BOOKING_URL=

# Social profiles (optional)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Analytics (optional; GA4 measurement ID or leave empty)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Server-only secrets (never commit real values) ----

# Email provider: "log" (default, console only) or "resend"
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=
# Where Connor receives lead notifications
LEAD_NOTIFY_EMAIL=

# Cloudflare Turnstile spam protection (optional; honeypot always active)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
